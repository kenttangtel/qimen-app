# ============================================================
#  Qimen API — environment template
#  Copy to `.env` and fill in real values. NEVER commit `.env`.
# ============================================================

# --- Database (PostgreSQL / Supabase) ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# --- JWT ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_API_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_VIP=price_xxx
STRIPE_PRICE_LIFETIME=price_xxx
STRIPE_PRICE_5_CREDITS=price_xxx
STRIPE_PRICE_15_CREDITS=price_xxx

# --- RevenueCat (mobile IAP webhook) ---
# REQUIRED in production. If unset, the webhook endpoint is disabled (503).
REVENUECAT_WEBHOOK_TOKEN=

# --- DeepSeek (AI interpretation) ---
DEEPSEEK_API_KEY=sk-xxx

# --- Email / password reset (Resend HTTP API) ---
# REQUIRED for /api/v1/auth/forgot-password
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=onboarding@resend.dev

# --- Supabase admin (optional; enables direct credit writes) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- CORS ---
# Comma-separated list of allowed origins. `*` is NOT recommended in production.
ALLOWED_ORIGINS=http://localhost:8000,https://kenttangtel-qimen-api.hf.space
